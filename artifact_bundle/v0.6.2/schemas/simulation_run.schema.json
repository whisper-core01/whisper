{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimulationRun",
  "description": "WHISPER Phase 2 minimal simulation run output. Expanded during v0.6-v0.7.",
  "type": "object",
  "required": ["schema_version", "metadata", "topology", "policy", "results"],
  "properties": {
    "schema_version": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["experiment_id", "seed", "whisper_version"],
      "properties": {
        "experiment_id": { "type": "string" },
        "seed": { "type": "string" },
        "whisper_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "topology": { "type": "object", "additionalProperties": true },
    "policy": { "type": "object", "additionalProperties": true },
    "results": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
