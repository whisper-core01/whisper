{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetricsReport",
  "description": "WHISPER Phase 2 minimal metrics report. Expanded during v0.6-v0.7.",
  "type": "object",
  "required": ["schema_version", "experiment_id", "metrics"],
  "properties": {
    "schema_version": { "type": "string" },
    "experiment_id": { "type": "string" },
    "metrics": {
      "type": "object",
      "properties": {
        "path_overlap": { "type": "number" },
        "unique_path_ratio": { "type": "number" },
        "lane_collapse_rate": { "type": "number" },
        "state_to_path_correlation": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
