{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BaselineComparison",
  "description": "WHISPER Phase 2 minimal baseline comparison output. Expanded during v0.7.",
  "type": "object",
  "required": ["schema_version", "experiment_id", "baselines"],
  "properties": {
    "schema_version": { "type": "string" },
    "experiment_id": { "type": "string" },
    "baselines": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "metrics"], "properties": { "name": { "type": "string" }, "metrics": { "type": "object", "additionalProperties": true } }, "additionalProperties": true }
    }
  },
  "additionalProperties": true
}
